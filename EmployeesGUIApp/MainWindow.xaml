<Window x:Class="EmployeesGUIApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ выплат сотрудникам (XML)" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите XML-файл с выплатами (Data1.xml или Data2.xml):" FontSize="14" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="FilePathTextBox" Width="500" IsReadOnly="True" Margin="0,0,10,0"/>
            <Button Content="Обзор..." Click="BrowseFile_Click" Width="80"/>
            <Button Content="Запустить анализ" Click="Analyze_Click" Width="120" Margin="10,0,0,0"
                    IsEnabled="False" x:Name="AnalyzeButton"/>
        </StackPanel>
        
        <TextBlock Grid.Row="2" Text="Список сотрудников:" FontWeight="Bold" Margin="0,10,0,5"/>
        <ListBox Grid.Row="2" x:Name="EmployeesListBox" Height="120" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Сумма выплат по месяцам:" FontWeight="Bold" Margin="0,10,0,5"/>
        <DataGrid Grid.Row="4" x:Name="MonthlyTotalsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Месяц" Binding="{Binding Month}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=C}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма добавления новой выплаты -->
        <GroupBox Grid.Row="5" Header="Добавить новую выплату" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <TextBlock Text="Имя:" Width="40" Margin="5,0"/>
                <TextBox x:Name="txtName" Width="90" Margin="5"/>
                <TextBlock Text="Фамилия:" Width="60" Margin="5,0"/>
                <TextBox x:Name="txtSurname" Width="90" Margin="5"/>
                <TextBlock Text="Сумма:" Width="50" Margin="5,0"/>
                <TextBox x:Name="txtAmount" Width="80" Margin="5" ToolTip="1234.56 или 1234,56"/>
                <TextBlock Text="Месяц:" Width="50" Margin="5,0"/>
                <TextBox x:Name="txtMonthEn" Width="90" Margin="5" ToolTip="january, february, march"/>
                <Button Content="Добавить" Click="AddPayment_Click" Width="90" Margin="10,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>